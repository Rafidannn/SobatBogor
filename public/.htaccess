# Apache URL Rewrite — SobatBogor
# Semua request (kecuali file/dir nyata) diteruskan ke index.php
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan rewrite file atau direktori yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Teruskan semua request ke index.php (Router baca REQUEST_URI)
    RewriteRule ^ index.php [L]
</IfModule>

# Blok akses langsung ke direktori sensitif
<FilesMatch "\.(env|sql|md|log|json|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
